1053:main.c        **** 			//Check to see if it's ours...
1054:main.c        **** 			uint8_t udrTemp = USIDR;
1055:main.c        **** 			//1 = master-read (slave-writes to SDA)
1056:main.c        **** 			//0 = master-write (slave-reads from SDA)
1057:main.c        **** 			usi_i2c_readFromSlave = udrTemp & 0x01;
1058:main.c        **** 			usi_i2c_requestedAddress = udrTemp >> 1;
