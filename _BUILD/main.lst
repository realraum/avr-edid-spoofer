1074:main.c        **** 			
1075:main.c        **** 			//From the manual:
1076:main.c        **** 			// When the slave is addressed, it holds the SDA line low during 
1077:main.c        **** 			// the acknowledgment cycle before holding the SCL line low again
1078:main.c        **** 			if( usi_i2c_isMyAddress(usi_i2c_requestedAddress) )
1079:main.c        **** 			{
1080:main.c        **** 				// Send ACK:
1081:main.c        **** 				// This is a hack:
1082:main.c        **** 				//  We get to this point on a falling-edge
1083:main.c        **** 				//  the USIDR bit 7 is loaded 0
1084:main.c        **** 				//  then the next rising edge it changes to bit 6
1085:main.c        **** 				//  the next falling edge triggers the AWAITING_ACK case below
1086:main.c        **** 				//  which releases bit 6 from the SDA pin
1087:main.c        **** 				//  The master pulls it low again for a STOP condition
1088:main.c        **** 				// It might be wiser to just set the PORT value...
1089:main.c        **** 				//USIDR = 0x3f; 
1090:main.c        **** 				USIDR = 0x00;
1091:main.c        **** 				setoutPORT(SDA_PIN, SDAPORT);
1092:main.c        **** 
1093:main.c        **** 	         usi_i2c_state = USI_STATE_AWAITING_ACK;
1094:main.c        **** 
1095:main.c        **** 	         //FTM:
GAS LISTING /tmp/cc0SE7YY.s 			page 26


1096:main.c        **** 	         // (The USI Counter Register is set to 14 before releasing SCL)
