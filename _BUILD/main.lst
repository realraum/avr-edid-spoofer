 136:main.c        **** //These are dual-pixel frequencies...
 137:main.c        **** // e.g. the single-pixel transmitter (built into the mac)
 138:main.c        **** // runs at twice this speed...
 139:main.c        **** //15MHz looks nasty on boot, but macOS handles it fine
