1111:main.c        **** 			}
1112:main.c        **** 			else //slaveWrite
1113:main.c        **** 			{
1114:main.c        **** 				uint8_t masterACK;
1115:main.c        **** 				// First ACK will be this device's response to address+r/w
1116:main.c        **** 				// Read the master's ACK?
1117:main.c        **** 				// I guess it'd be stupid to send a read request without
1118:main.c        **** 				// actually reading a byte, but I've done it for testing...
1119:main.c        **** 				// but if that's the case, then the byteToTransmit will be 
1120:main.c        **** 				// decremented anyhow... Not sure how to handle this yet...
1121:main.c        **** 				// OTOH: if a read is requested a byte MUST be transferred
1122:main.c        **** 				// otherwise a bit-7 = 0 loaded would prevent a master-stop
1123:main.c        **** 				masterACK = !(USIDR & 0x01);
