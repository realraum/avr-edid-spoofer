1039:main.c        **** 			// ALSO the Overflow flag for the same reason
1040:main.c        **** 			// ALSO: set the counter
1041:main.c        **** 			//   16 clock edges will signal 8 bits received (address+r/w)
1042:main.c        **** 			USISR = (1<<USISIF) //Start Condition Interrupt Flag
1043:main.c        **** 										//  (ONLY cleared when written 1)
1044:main.c        **** 					| (1<<USIOIF)	//Overflow flag 
1045:main.c        **** 		         | (USICNT_MASK & 0); //Clear the USI counter
1046:main.c        **** 
