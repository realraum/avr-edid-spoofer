1029:main.c        **** 		// The start condition interrupt occurs immediately when SDA goes low
1030:main.c        **** 		//  while SCL is high. The SCL line needs to go low once before
1031:main.c        **** 		//  data can be transmitted (this was a BITCH to find)
1032:main.c        **** 		//  in other words, there are 17 clock edges between the start-
1033:main.c        **** 		//  condition and having fully received the r/w bit
1034:main.c        **** 		case USI_STATE_START_SCL_RECEIVED:
1035:main.c        **** 	//		usi_i2c_awaitAddress();
1036:main.c        **** 			usi_i2c_state = USI_STATE_AWAITING_ADDRESS;
